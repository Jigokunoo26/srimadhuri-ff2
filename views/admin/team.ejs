<%- include('partials/header') %>

<div class="page-header animate-in">
    <div class="page-title-group">
        <div class="page-title">Team Members</div>
        <div class="page-subtitle">Add and manage your salon's team roster</div>
    </div>
</div>

<div class="grid-2">
    <!-- Add New Member -->
    <div class="card animate-in">
        <div class="card-title-main" style="margin-bottom:1.25rem;"><i class="fas fa-user-plus"></i> Add Team Member</div>
        <form action="/admin/team/add" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="name" required placeholder="e.g. Sri Madhuri">
            </div>
            <div class="grid-2" style="gap:1rem;">
                <div class="form-group">
                    <label>Role / Title</label>
                    <input type="text" name="role" required placeholder="e.g. Lead Makeup Artist">
                </div>
                <div class="form-group">
                    <label>Experience</label>
                    <input type="text" name="experience" placeholder="e.g. 5+ Years">
                </div>
            </div>
            <div class="form-group">
                <label>Profile Photo (Optional)</label>
                <input type="file" name="image" accept="image/*" style="padding:0.6rem; cursor:pointer;">
            </div>
            <div style="text-align:right; margin-top:0.5rem;">
                <button type="submit" class="btn"><i class="fas fa-user-plus"></i> Add Member</button>
            </div>
        </form>
    </div>

    <!-- Team List -->
    <div class="card animate-in">
        <div class="card-title-main" style="margin-bottom:1.25rem;"><i class="fas fa-users"></i> Team Roster (<%= team.length %>)</div>
        <% if (team && team.length > 0) { %>
            <div style="display:flex; flex-direction:column; gap:0.75rem;">
                <% team.forEach(m => { %>
                    <div class="person-card">
                        <% if (m.image) { %>
                            <img src="<%= m.image %>" alt="<%= m.name %>" class="person-avatar">
                        <% } else { %>
                            <div class="person-avatar-placeholder"><%= m.name.charAt(0).toUpperCase() %></div>
                        <% } %>
                        <div class="person-info">
                            <div class="person-name"><%= m.name %></div>
                            <div class="person-role"><%= m.role %></div>
                            <% if (m.experience) { %>
                                <div class="person-detail"><i class="fas fa-briefcase" style="font-size:0.65rem; color:var(--text-muted)"></i> <%= m.experience %></div>
                            <% } %>
                        </div>
                        <form action="/admin/team/delete/<%= m.id %>" method="POST" onsubmit="return confirm('Remove this team member?');" style="margin:0;">
                            <button type="submit" class="btn btn-danger btn-icon btn-sm" title="Remove"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                <p>No team members added yet.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
