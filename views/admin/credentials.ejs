<%- include('partials/header') %>

<div class="page-header animate-in">
    <div class="page-title-group">
        <div class="page-title">Credentials</div>
        <div class="page-subtitle">Update your admin login and recovery settings</div>
    </div>
</div>

<div class="grid-2">
    <!-- Update Login -->
    <div class="card animate-in">
        <div class="card-title-main" style="margin-bottom:0.35rem;"><i class="fas fa-user-lock"></i> Update Login</div>
        <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1.25rem;">You'll be logged out after any credential change.</p>

        <% if (error) { %>
            <div class="alert alert-error"><i class="fas fa-circle-exclamation"></i> <%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><i class="fas fa-circle-check"></i> <%= success %></div>
        <% } %>

        <form action="/admin/credentials" method="POST" id="credentials-form">
            <div class="form-group">
                <label><i class="fas fa-key" style="margin-right:5px"></i>Current Password <span style="color:var(--danger)">*</span></label>
                <div style="position:relative;">
                    <input type="password" name="currentPassword" id="currentPassword" placeholder="Enter current password" required>
                    <button type="button" class="eye-toggle" onclick="togglePassword('currentPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <hr class="divider">

            <div class="form-group">
                <label><i class="fas fa-user" style="margin-right:5px"></i>Username</label>
                <input type="text" name="newUsername" id="newUsername" value="<%= currentUsername %>" placeholder="New username" required minlength="3">
            </div>
            <div class="form-group">
                <label><i class="fas fa-lock" style="margin-right:5px"></i>New Password <span style="color:var(--text-muted);font-weight:400;text-transform:none;">(blank = keep current)</span></label>
                <div style="position:relative;">
                    <input type="password" name="newPassword" id="newPassword" placeholder="New password (min 6 chars)" minlength="6">
                    <button type="button" class="eye-toggle" onclick="togglePassword('newPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label><i class="fas fa-lock" style="margin-right:5px"></i>Confirm New Password</label>
                <div style="position:relative;">
                    <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm new password">
                    <button type="button" class="eye-toggle" onclick="togglePassword('confirmPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn" style="width:100%;justify-content:center;margin-top:0.5rem;">
                <i class="fas fa-save"></i> Update Credentials
            </button>
        </form>
    </div>

    <!-- Right Column -->
    <div style="display:flex;flex-direction:column;gap:1.5rem;">
        <!-- Recovery Info -->
        <div class="card animate-in" style="border-color:rgba(212,175,55,0.2);">
            <div class="card-title-main" style="margin-bottom:0.35rem;"><i class="fas fa-envelope-open-text"></i> Recovery Info</div>
            <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1.25rem;">Used for OTP-based password reset from the login page.</p>
            <form action="/admin/credentials/recovery" method="POST">
                <div class="form-group">
                    <label><i class="fas fa-envelope" style="margin-right:5px"></i>Recovery Email</label>
                    <input type="email" name="recoveryEmail" value="<%= typeof currentEmail !== 'undefined' ? currentEmail : '' %>" placeholder="your@email.com" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-phone" style="margin-right:5px"></i>Recovery Phone</label>
                    <input type="text" name="recoveryPhone" value="<%= typeof currentPhone !== 'undefined' ? currentPhone : '' %>" placeholder="e.g. 8985291053">
                </div>
                <button type="submit" class="btn" style="width:100%;justify-content:center;">
                    <i class="fas fa-save"></i> Update Recovery Info
                </button>
            </form>
        </div>

        <!-- Security Notes -->
        <div class="card animate-in" style="background:linear-gradient(135deg,rgba(212,175,55,0.05),rgba(99,102,241,0.04));border-color:rgba(212,175,55,0.15);">
            <div class="card-title-main" style="margin-bottom:1rem;"><i class="fas fa-shield-halved"></i> Security Info</div>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
                <% [
                    'Passwords are encrypted with bcrypt',
                    'Current password required for changes',
                    'Session destroyed after credential update',
                    'Minimum 6 character password enforced',
                    'OTP-based recovery via email / WhatsApp'
                ].forEach(item => { %>
                    <li style="display:flex;align-items:center;gap:10px;font-size:0.82rem;color:var(--text-secondary);">
                        <i class="fas fa-circle-check" style="color:var(--success);font-size:0.75rem;flex-shrink:0"></i>
                        <%= item %>
                    </li>
                <% }) %>
            </ul>
        </div>

        <!-- Important Notes -->
        <div class="card animate-in">
            <div class="card-title-main" style="margin-bottom:1rem;color:var(--warning);"><i class="fas fa-triangle-exclamation"></i> Important Notes</div>
            <ul style="padding-left:1.25rem;margin:0;display:flex;flex-direction:column;gap:6px;color:var(--text-muted);font-size:0.82rem;line-height:1.5;">
                <li>After updating, you'll be <strong style="color:var(--text-primary)">logged out</strong> immediately</li>
                <li>Use your <strong style="color:var(--text-primary)">new credentials</strong> to log back in</li>
                <li>If only changing username, your password stays the same</li>
                <li>Keep recovery email/phone <strong style="color:var(--text-primary)">up to date</strong></li>
            </ul>
        </div>
    </div>
</div>

<style>
    .eye-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        font-size: 0.85rem;
        padding: 4px;
        transition: color 0.2s;
    }
    .eye-toggle:hover { color: var(--gold); }
</style>

<script>
    function togglePassword(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }
    document.getElementById('credentials-form').addEventListener('submit', function(e) {
        const np = document.getElementById('newPassword').value;
        const cp = document.getElementById('confirmPassword').value;
        if (np && np !== cp) {
            e.preventDefault();
            alert('New password and confirm password do not match!');
        }
        if (np && np.length < 6) {
            e.preventDefault();
            alert('New password must be at least 6 characters!');
        }
    });
</script>

<%- include('partials/footer') %>
