<%- include('partials/header') %>

<div class="page-header animate-in">
    <div class="page-title-group">
        <div class="page-title">Offers & Deals</div>
        <div class="page-subtitle">Create promotional packages shown on the website</div>
    </div>
</div>

<div class="grid-2">
    <!-- Add New Offer -->
    <div class="card animate-in">
        <div class="card-title-main" style="margin-bottom:1.25rem;"><i class="fas fa-tags"></i> Create New Offer</div>
        <form action="/admin/offers/add" method="POST">
            <div class="form-group">
                <label>Offer Title</label>
                <input type="text" name="title" required placeholder="e.g. Monsoon Glow Package">
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="2" required placeholder="Short description of this package..."></textarea>
            </div>
            <div class="grid-2" style="gap:1rem;">
                <div class="form-group">
                    <label>Original Price</label>
                    <input type="text" name="originalPrice" id="originalPrice" required placeholder="e.g. ₹3,500">
                </div>
                <div class="form-group">
                    <label>Offer Price</label>
                    <input type="text" name="offerPrice" id="offerPrice" required placeholder="e.g. ₹2,499">
                </div>
            </div>
            <div class="grid-2" style="gap:1rem;">
                <div class="form-group">
                    <label>Discount Text</label>
                    <input type="text" name="discount" id="discountText" required placeholder="e.g. 30% OFF">
                </div>
                <div class="form-group">
                    <label>Badge Label</label>
                    <input type="text" name="badge" required placeholder="e.g. Limited Time">
                </div>
            </div>
            <div class="form-group">
                <label>End Date (Optional)</label>
                <input type="datetime-local" name="endDate">
            </div>
            <label class="checkbox-label" style="margin-bottom:1.5rem;">
                <input type="checkbox" name="active" checked>
                Show on website (Active)
            </label>
            <div style="text-align:right;">
                <button type="submit" class="btn"><i class="fas fa-plus"></i> Add Offer</button>
            </div>
        </form>
    </div>

    <!-- Existing Offers -->
    <div class="card animate-in">
        <div class="card-title-main" style="margin-bottom:1.25rem;"><i class="fas fa-receipt"></i> Current Offers (<%= offers.length %>)</div>
        <% if (offers && offers.length > 0) { %>
            <div style="display:flex; flex-direction:column; gap:0.75rem; max-height:600px; overflow-y:auto; padding-right:4px;">
                <% offers.forEach(o => { %>
                    <div class="offer-card">
                        <div class="offer-badge-pill"><%= o.badge %></div>
                        <div class="offer-title"><%= o.title %></div>
                        <div class="offer-desc"><%= o.description %></div>
                        <div class="offer-price">
                            <span class="offer-price-new"><%= o.offerPrice %></span>
                            <span class="offer-price-old"><%= o.originalPrice %></span>
                            <span class="badge badge-confirmed" style="font-size:0.65rem;margin-left:4px"><%= o.discount %></span>
                        </div>
                        <% if (o.endDate) { %>
                            <div style="font-size:0.72rem;color:var(--text-muted);margin-top:6px"><i class="fas fa-clock" style="font-size:0.65rem"></i> Ends <%= new Date(o.endDate).toLocaleDateString('en-IN') %></div>
                        <% } %>
                        <div class="offer-actions">
                            <form action="/admin/offers/toggle/<%= o.id %>" method="POST" style="margin:0;">
                                <button type="submit" class="btn btn-outline btn-sm" title="Toggle status">
                                    <% if(o.active) { %>
                                        <i class="fas fa-eye-slash"></i> Deactivate
                                    <% } else { %>
                                        <i class="fas fa-eye"></i> Activate
                                    <% } %>
                                </button>
                            </form>
                            <form action="/admin/offers/delete/<%= o.id %>" method="POST" style="margin:0;" onsubmit="return confirm('Delete this offer permanently?');">
                                <button type="submit" class="btn btn-danger btn-sm" title="Delete"><i class="fas fa-trash"></i></button>
                            </form>
                            <% if(o.active) { %>
                                <span class="badge badge-confirmed" style="margin-left:auto;"><i class="fas fa-circle" style="font-size:0.5rem"></i> Live</span>
                            <% } else { %>
                                <span class="badge badge-hidden" style="margin-left:auto;">Hidden</span>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i class="fas fa-tags"></i>
                <p>No offers yet. Create your first promotional deal!</p>
            </div>
        <% } %>
    </div>
</div>

<script>
    function calculateDiscount() {
        const orig  = parseFloat(document.getElementById('originalPrice').value.replace(/[^0-9.]/g,''));
        const offer = parseFloat(document.getElementById('offerPrice').value.replace(/[^0-9.]/g,''));
        if (!isNaN(orig) && !isNaN(offer) && orig > 0) {
            const pct = Math.max(0, Math.round(((orig - offer) / orig) * 100));
            document.getElementById('discountText').value = pct + '% OFF';
        }
    }
    document.getElementById('originalPrice').addEventListener('input', calculateDiscount);
    document.getElementById('offerPrice').addEventListener('input', calculateDiscount);
</script>

<%- include('partials/footer') %>
