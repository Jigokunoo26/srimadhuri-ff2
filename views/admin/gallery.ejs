<%- include('partials/header') %>

<div class="page-header animate-in">
    <div class="page-title-group">
        <div class="page-title">Gallery</div>
        <div class="page-subtitle">Upload and manage salon portfolio images</div>
    </div>
</div>

<!-- Upload Card -->
<div class="card animate-in" style="max-width:560px;">
    <div class="card-title-main" style="margin-bottom:1.25rem;"><i class="fas fa-cloud-arrow-up"></i> Upload New Image</div>
    <form action="/admin/gallery/add" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label>Image File</label>
            <input type="file" name="image" accept="image/*" required style="padding:0.6rem; cursor:pointer;">
        </div>
        <div class="form-group">
            <label>Category</label>
            <select name="category">
                <option value="Bridal">✨ Bridal</option>
                <option value="Hair">💇 Hair</option>
                <option value="Makeup">💄 Makeup</option>
                <option value="General">📷 General</option>
            </select>
        </div>
        <div style="text-align:right; margin-top:0.5rem;">
            <button type="submit" class="btn"><i class="fas fa-upload"></i> Upload</button>
        </div>
    </form>
</div>

<!-- Gallery Grid -->
<div class="card-title-main" style="margin-bottom:1rem;"><i class="fas fa-images"></i> All Photos (<%= gallery.length %>)</div>

<% if (gallery && gallery.length > 0) { %>
    <div class="gallery-grid">
        <% gallery.forEach(img => { %>
            <div class="gallery-item">
                <img src="<%= img.image %>" alt="<%= img.category %>">
                <div class="overlay">
                    <span class="badge badge-completed" style="font-size:0.65rem"><%= img.category %></span>
                    <form action="/admin/gallery/delete/<%= img.id %>" method="POST" onsubmit="return confirm('Delete this image permanently?');" style="margin:0;">
                        <button type="submit" class="btn btn-danger btn-icon btn-sm" title="Delete"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>
<% } else { %>
    <div class="card empty-state">
        <i class="fas fa-camera-retro"></i>
        <p>No images uploaded yet. Upload your first salon photo!</p>
    </div>
<% } %>

<%- include('partials/footer') %>
