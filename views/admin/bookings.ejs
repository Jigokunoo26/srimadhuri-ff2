<%- include('partials/header') %>

<div class="page-header animate-in">
    <div class="page-title-group">
        <div class="page-title">Bookings</div>
        <div class="page-subtitle">Manage and update customer appointments</div>
    </div>
</div>

<div class="card animate-in" style="padding:0; overflow:hidden;">
    <% if (bookings.length > 0) { %>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Status</th>
                        <th>Update</th>
                    </tr>
                </thead>
                <tbody>
                    <% bookings.forEach(b => { %>
                        <tr>
                            <td>
                                <div style="font-weight:600;"><%= b.date %></div>
                                <div style="font-size:0.78rem;color:var(--gold);margin-top:2px"><i class="fas fa-clock" style="font-size:0.65rem"></i> <%= b.time %></div>
                            </td>
                            <td>
                                <div style="font-weight:600;color:var(--text-primary)"><%= b.name %></div>
                                <a href="https://wa.me/<%= b.phone.replace(/\D/g, '') %>" target="_blank" style="color:var(--success);text-decoration:none;font-size:0.78rem;margin-top:3px;display:flex;align-items:center;gap:4px;">
                                    <i class="fab fa-whatsapp"></i> <%= b.phone %>
                                </a>
                                <div style="font-size:0.75rem;color:var(--text-muted);margin-top:1px"><%= b.email %></div>
                            </td>
                            <td>
                                <div style="font-weight:600;font-size:0.875rem"><%= b.service %></div>
                                <% if (b.message) { %>
                                    <div style="font-size:0.75rem;color:var(--text-muted);margin-top:3px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= b.message %>"><%= b.message %></div>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge badge-<%= b.status %>"><%= b.status %></span>
                            </td>
                            <td>
                                <form action="/admin/bookings/<%= b.id %>/status" method="POST">
                                    <select name="status" onchange="this.form.submit()" style="margin:0;padding:0.5rem 0.75rem;width:130px;font-size:0.8rem;background:var(--bg-input);color:var(--text-primary);border:1px solid var(--border-card);">
                                        <option value="pending"   <%= b.status === 'pending'   ? 'selected' : '' %>>⏳ Pending</option>
                                        <option value="confirmed" <%= b.status === 'confirmed' ? 'selected' : '' %>>✅ Confirmed</option>
                                        <option value="completed" <%= b.status === 'completed' ? 'selected' : '' %>>✨ Completed</option>
                                        <option value="cancelled" <%= b.status === 'cancelled' ? 'selected' : '' %>>❌ Cancelled</option>
                                    </select>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="empty-state">
            <i class="fas fa-calendar-xmark"></i>
            <p>No bookings found in the database.</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
