<%- include('partials/header') %>

<div class="page-header animate-in">
    <div class="page-title-group">
        <div class="page-title">Testimonials</div>
        <div class="page-subtitle">Manage customer reviews and ratings</div>
    </div>
</div>

<div class="grid-2">
    <!-- Add Testimonial -->
    <div class="card animate-in">
        <div class="card-title-main" style="margin-bottom:1.25rem;"><i class="fas fa-star"></i> Add Testimonial</div>
        <form action="/admin/testimonials/add" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Customer Name</label>
                <input type="text" name="name" required placeholder="e.g. Priya Reddy">
            </div>
            <div class="grid-2" style="gap:1rem;">
                <div class="form-group">
                    <label>Role / Detail</label>
                    <input type="text" name="role" placeholder="e.g. Bridal Client">
                </div>
                <div class="form-group">
                    <label>Rating (1–5)</label>
                    <select name="rating">
                        <option value="5">⭐⭐⭐⭐⭐ — 5 Stars</option>
                        <option value="4">⭐⭐⭐⭐ — 4 Stars</option>
                        <option value="3">⭐⭐⭐ — 3 Stars</option>
                        <option value="2">⭐⭐ — 2 Stars</option>
                        <option value="1">⭐ — 1 Star</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>Customer Photo (Optional)</label>
                <input type="file" name="image" accept="image/*" style="padding:0.6rem; cursor:pointer;">
            </div>
            <div class="form-group">
                <label>Feedback Text</label>
                <textarea name="text" rows="4" required placeholder="Enter their glowing review..."></textarea>
            </div>
            <div style="text-align:right;">
                <button type="submit" class="btn"><i class="fas fa-plus"></i> Add Review</button>
            </div>
        </form>
    </div>

    <!-- Testimonials List -->
    <div class="card animate-in">
        <div class="card-title-main" style="margin-bottom:1.25rem;"><i class="fas fa-comments"></i> All Reviews (<%= testimonials.length %>)</div>
        <% if (testimonials && testimonials.length > 0) { %>
            <div style="display:flex; flex-direction:column; gap:0.75rem; max-height:580px; overflow-y:auto; padding-right:4px;">
                <% testimonials.forEach(t => { %>
                    <div class="person-card" style="flex-direction:column; align-items:flex-start; gap:0.75rem;">
                        <div style="display:flex; align-items:center; gap:12px; width:100%;">
                            <% if (t.image) { %>
                                <img src="<%= t.image %>" alt="<%= t.name %>" class="person-avatar" style="border-radius:50%;">
                            <% } else { %>
                                <div class="person-avatar-placeholder" style="border-radius:50%;width:42px;height:42px;font-size:1rem;"><%= t.name.charAt(0).toUpperCase() %></div>
                            <% } %>
                            <div class="person-info">
                                <div class="person-name"><%= t.name %></div>
                                <div class="person-role"><%= t.role %></div>
                                <div class="stars"><%= '★'.repeat(t.rating || 5) %><%= '☆'.repeat(5 - (t.rating || 5)) %></div>
                            </div>
                            <form action="/admin/testimonials/delete/<%= t.id %>" method="POST" onsubmit="return confirm('Delete this review?');" style="margin:0;margin-left:auto;">
                                <button type="submit" class="btn btn-danger btn-icon btn-sm" title="Delete"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                        <p style="font-size:0.82rem; color:var(--text-secondary); line-height:1.6; margin:0; padding-left:54px;">"<%= t.text %>"</p>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i class="fas fa-star-half-stroke"></i>
                <p>No testimonials added yet.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
