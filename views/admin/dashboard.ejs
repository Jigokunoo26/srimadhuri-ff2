<%- include('partials/header') %>

<div class="page-header animate-in">
    <div class="page-title-group">
        <div class="page-title">Dashboard</div>
        <div class="page-subtitle">Welcome back — here's what's happening today</div>
    </div>
    <a href="/admin/bookings" class="btn btn-outline"><i class="fas fa-calendar-check"></i> All Bookings</a>
</div>

<!-- Stat Cards -->
<div class="grid-3" style="margin-bottom:1.5rem;">
    <div class="stat-card gold animate-in">
        <div class="stat-icon"><i class="fas fa-calendar-days"></i></div>
        <div class="stat-label">Total Bookings</div>
        <div class="stat-value"><%= totalBookings %></div>
        <div class="stat-trend"><i class="fas fa-chart-line"></i> All time</div>
    </div>
    <div class="stat-card green animate-in">
        <div class="stat-icon"><i class="fas fa-sun"></i></div>
        <div class="stat-label">Today's Bookings</div>
        <div class="stat-value"><%= todayBookings %></div>
        <div class="stat-trend"><i class="fas fa-calendar"></i> Today only</div>
    </div>
    <div class="stat-card amber animate-in">
        <div class="stat-icon"><i class="fas fa-clock"></i></div>
        <div class="stat-label">Pending Approval</div>
        <div class="stat-value"><%= pendingBookings %></div>
        <div class="stat-trend"><i class="fas fa-hourglass-half"></i> Awaiting action</div>
    </div>
</div>

<!-- Recent Bookings -->
<div class="card animate-in">
    <div class="card-title">
        <div class="card-title-main"><i class="fas fa-clock-rotate-left"></i> Recent Bookings</div>
        <a href="/admin/bookings" class="btn btn-outline btn-sm">View All &rarr;</a>
    </div>

    <% if (recentBookings.length > 0) { %>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% recentBookings.forEach(b => { %>
                        <tr>
                            <td>
                                <div style="font-weight:600; color:var(--text-primary)"><%= b.date %></div>
                                <div style="font-size:0.78rem; color:var(--text-muted); margin-top:2px"><%= b.time %></div>
                            </td>
                            <td>
                                <div style="font-weight:600"><%= b.name %></div>
                                <div style="font-size:0.78rem; color:var(--text-muted); margin-top:2px"><%= b.phone %></div>
                            </td>
                            <td style="color:var(--text-secondary)"><%= b.service %></td>
                            <td>
                                <span class="badge badge-<%= b.status %>"><%= b.status %></span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="empty-state">
            <i class="fas fa-calendar-xmark"></i>
            <p>No bookings yet. They'll appear here when customers book appointments.</p>
        </div>
    <% } %>
</div>

<!-- Quick Links -->
<div class="grid-3" style="margin-top:0.5rem;">
    <a href="/admin/services" class="card" style="text-decoration:none; display:flex; align-items:center; gap:14px; padding:1.25rem; cursor:pointer;">
        <div style="width:42px;height:42px;background:var(--gold-glow);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:1.1rem;flex-shrink:0"><i class="fas fa-spa"></i></div>
        <div>
            <div style="font-weight:700;font-size:0.9rem">Manage Services</div>
            <div style="font-size:0.78rem;color:var(--text-muted);margin-top:2px">Add, edit or hide services</div>
        </div>
        <i class="fas fa-chevron-right" style="color:var(--text-muted);margin-left:auto;font-size:0.75rem"></i>
    </a>
    <a href="/admin/offers" class="card" style="text-decoration:none; display:flex; align-items:center; gap:14px; padding:1.25rem; cursor:pointer;">
        <div style="width:42px;height:42px;background:var(--success-bg);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--success);font-size:1.1rem;flex-shrink:0"><i class="fas fa-tags"></i></div>
        <div>
            <div style="font-weight:700;font-size:0.9rem">Offers & Deals</div>
            <div style="font-size:0.78rem;color:var(--text-muted);margin-top:2px">Create and manage promotions</div>
        </div>
        <i class="fas fa-chevron-right" style="color:var(--text-muted);margin-left:auto;font-size:0.75rem"></i>
    </a>
    <a href="/admin/gallery" class="card" style="text-decoration:none; display:flex; align-items:center; gap:14px; padding:1.25rem; cursor:pointer;">
        <div style="width:42px;height:42px;background:var(--info-bg);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--info);font-size:1.1rem;flex-shrink:0"><i class="fas fa-images"></i></div>
        <div>
            <div style="font-weight:700;font-size:0.9rem">Gallery</div>
            <div style="font-size:0.78rem;color:var(--text-muted);margin-top:2px">Upload and manage photos</div>
        </div>
        <i class="fas fa-chevron-right" style="color:var(--text-muted);margin-left:auto;font-size:0.75rem"></i>
    </a>
</div>

<%- include('partials/footer') %>
